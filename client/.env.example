# Copy to .env.local for local overrides, or set these in Vercel → Project Settings → Environment Variables.

# Canonical site origin used for canonical URLs, sitemap.xml, robots.txt, structured data, and social cards.
# Defaults to https://gofundyourselfinc.com when unset.
NEXT_PUBLIC_SITE_URL=https://gofundyourselfinc.com

# Search console ownership verification (the content value of the meta tag each console gives you).
# Google: https://search.google.com/search-console  → Add property → HTML tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing: https://www.bing.com/webmasters  → Add site → HTML Meta Tag (msvalidate.01)
NEXT_PUBLIC_BING_SITE_VERIFICATION=
